# Resona environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# --- Telegram (required) ---
BOT_TOKEN=
BOT_OWNER_ID=

# --- Database (required) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=resona

# --- Credential encryption (required for account linking) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COOKIE_ENCRYPTION_KEY=

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
CONCURRENT_UPDATES=32

# --- Rich messages (Bot API 10.1+; falls back to plain text when unavailable) ---
RICH_MESSAGES_ENABLED=true

# --- Background jobs ---
# Daily check-in runs after the HoYoLAB reset (00:00 UTC+8 = 16:00 UTC).
CHECKIN_ENABLED=true
CHECKIN_HOUR_UTC=16
CHECKIN_MINUTE_UTC=5

# Opt-in event digest. Users enable it with /settings event_digest on.
EVENT_DIGEST_ENABLED=true
EVENT_DIGEST_HOUR_UTC=9
EVENT_DIGEST_MINUTE_UTC=0
EVENT_DIGEST_DAYS=3

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=20

# --- Local Bot API server (optional) ---
LOCAL_BOT_API=false
BOT_API_BASE_URL=http://127.0.0.1:8081/bot
BOT_API_FILE_URL=http://127.0.0.1:8081/file/bot
